#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    mkdir -p /var/cache/salt/minion /var/run/salt/minion /var/log/salt /etc/salt/pki/minion
    chmod 700 /etc/salt/pki/minion
    procd_open_instance
    procd_set_param command /usr/bin/salt-minion -c /etc/salt
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/salt/minion /etc/salt/minion.d/*.conf
    procd_close_instance
}
